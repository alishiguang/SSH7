{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH7",
  "version": "1.2.7",
  "identifier": "com.alishiguang.ssh7",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSH7",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#08080a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 SSH7 Contributors",
    "shortDescription": "简洁酷炫的跨平台 SSH 客户端",
    "longDescription": "SSH7 是一款用 Rust 编写的跨平台 SSH 客户端，支持多会话终端、SFTP 文件管理与拖拽传输。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
